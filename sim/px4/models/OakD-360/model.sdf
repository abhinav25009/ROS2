<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='OakD-360'>
    <link name="camera_360_link">
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>1e-05</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>1e-05</iyy><iyz>0</iyz><izz>1e-05</izz>
        </inertia>
      </inertial>
<sensor name="depth_front" type="depth_camera">
  <gz_frame_id>cam_front_link</gz_frame_id>
  <pose>0 0 0 0 0 0</pose>
  <camera>
    <horizontal_fov>1.6</horizontal_fov>
    <image>
      <width>160</width>
      <height>120</height>
      <format>R_FLOAT32</format>
    </image>
    <clip><near>0.2</near><far>10</far></clip>
  </camera>
  <always_on>1</always_on>
  <update_rate>5</update_rate>
  <visualize>false</visualize>
  <topic>depth_front</topic>
</sensor>
<sensor name="depth_right" type="depth_camera">
  <gz_frame_id>cam_right_link</gz_frame_id>
  <pose>0 0 0 0 0 -1.5708</pose>
  <camera>
    <horizontal_fov>1.6</horizontal_fov>
    <image>
      <width>160</width>
      <height>120</height>
      <format>R_FLOAT32</format>
    </image>
    <clip><near>0.2</near><far>10</far></clip>
  </camera>
  <always_on>1</always_on>
  <update_rate>5</update_rate>
  <visualize>false</visualize>
  <topic>depth_right</topic>
</sensor>
<sensor name="depth_rear" type="depth_camera">
  <gz_frame_id>cam_rear_link</gz_frame_id>
  <pose>0 0 0 0 0 3.14159</pose>
  <camera>
    <horizontal_fov>1.6</horizontal_fov>
    <image>
      <width>160</width>
      <height>120</height>
      <format>R_FLOAT32</format>
    </image>
    <clip><near>0.2</near><far>10</far></clip>
  </camera>
  <always_on>1</always_on>
  <update_rate>5</update_rate>
  <visualize>false</visualize>
  <topic>depth_rear</topic>
</sensor>
<sensor name="depth_left" type="depth_camera">
  <gz_frame_id>cam_left_link</gz_frame_id>
  <pose>0 0 0 0 0 1.5708</pose>
  <camera>
    <horizontal_fov>1.6</horizontal_fov>
    <image>
      <width>160</width>
      <height>120</height>
      <format>R_FLOAT32</format>
    </image>
    <clip><near>0.2</near><far>10</far></clip>
  </camera>
  <always_on>1</always_on>
  <update_rate>5</update_rate>
  <visualize>false</visualize>
  <topic>depth_left</topic>
</sensor>
<sensor name="depth_up" type="depth_camera">
  <gz_frame_id>cam_up_link</gz_frame_id>
  <pose>0 0 0 0 -1.5708 0</pose>
  <camera>
    <horizontal_fov>1.6</horizontal_fov>
    <image>
      <width>160</width>
      <height>120</height>
      <format>R_FLOAT32</format>
    </image>
    <clip><near>0.2</near><far>10</far></clip>
  </camera>
  <always_on>1</always_on>
  <update_rate>2</update_rate>
  <visualize>false</visualize>
  <topic>depth_up</topic>
</sensor>
      <gravity>true</gravity>
      <velocity_decay/>
    </link>
  </model>
</sdf>
