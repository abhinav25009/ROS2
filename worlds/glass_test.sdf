<?xml version="1.0" ?>
<!--
  glass_test: one room with a pane of "glass" the drone cannot see.

  Room x -3..11, y -3..7 (inner faces -2.8..10.8, -2.8..6.8), walls and
  ceiling 2.8 m, all with visuals (the depth cameras see them).
  The GLASS is a collision-only box at x = 4 from the south wall to y = 4.5:
  it stops the drone physically, but the depth cameras render visuals only,
  so it never reaches the OctoMap - like real glass, or the railing posts the
  map lost in the 2026-11-17 flight. Way round: the 2.3 m gap y 4.5..6.8.
  A thin red floor stripe (visual only, below occupancy_min_z) marks it in
  renders. Drone spawns at the origin; test goal (8, 0, 1.8).
  Mirrors the 'glass' scenario of benchmark/stuck_sim.py.
-->
<sdf version="1.9">
  <world name="glass_test">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::ApplyLinkWrench" filename="gz-sim-apply-link-wrench-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gui fullscreen="false"/>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>488</elevation>
    </spherical_coordinates>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>40 40</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="room">
      <static>true</static>
      <link name="link">
        <collision name="c_south"><pose>4 -2.9 1.4 0 0 0</pose><geometry><box><size>14 0.2 2.8</size></box></geometry></collision>
        <visual name="v_south"><pose>4 -2.9 1.4 0 0 0</pose><geometry><box><size>14 0.2 2.8</size></box></geometry>
          <material><ambient>0.7 0.7 0.6 1</ambient><diffuse>0.7 0.7 0.6 1</diffuse></material></visual>
        <collision name="c_north"><pose>4 6.9 1.4 0 0 0</pose><geometry><box><size>14 0.2 2.8</size></box></geometry></collision>
        <visual name="v_north"><pose>4 6.9 1.4 0 0 0</pose><geometry><box><size>14 0.2 2.8</size></box></geometry>
          <material><ambient>0.7 0.7 0.6 1</ambient><diffuse>0.7 0.7 0.6 1</diffuse></material></visual>
        <collision name="c_west"><pose>-2.9 2 1.4 0 0 0</pose><geometry><box><size>0.2 10 2.8</size></box></geometry></collision>
        <visual name="v_west"><pose>-2.9 2 1.4 0 0 0</pose><geometry><box><size>0.2 10 2.8</size></box></geometry>
          <material><ambient>0.7 0.7 0.6 1</ambient><diffuse>0.7 0.7 0.6 1</diffuse></material></visual>
        <collision name="c_east"><pose>10.9 2 1.4 0 0 0</pose><geometry><box><size>0.2 10 2.8</size></box></geometry></collision>
        <visual name="v_east"><pose>10.9 2 1.4 0 0 0</pose><geometry><box><size>0.2 10 2.8</size></box></geometry>
          <material><ambient>0.7 0.7 0.6 1</ambient><diffuse>0.7 0.7 0.6 1</diffuse></material></visual>
        <collision name="c_ceiling"><pose>4 2 2.9 0 0 0</pose><geometry><box><size>14 10 0.2</size></box></geometry></collision>
        <visual name="v_ceiling"><pose>4 2 2.9 0 0 0</pose><geometry><box><size>14 10 0.2</size></box></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material></visual>
      </link>
    </model>

    <!-- THE GLASS: collision only, no visual -> invisible to the depth cameras -->
    <model name="glass_pane">
      <static>true</static>
      <link name="link">
        <collision name="c_glass"><pose>4 0.85 1.4 0 0 0</pose><geometry><box><size>0.05 7.3 2.8</size></box></geometry></collision>
        <visual name="v_floor_marker"><pose>4 0.85 0.002 0 0 0</pose><geometry><box><size>0.06 7.3 0.004</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
